        </mxCell>
        <mxCell id="sq-admin-t0152" value="401/403 — нет сессии/прав&lt;br&gt;413 — файл слишком большой&lt;br&gt;422 — ошибки строк&lt;br&gt;409 — конфликт версии&lt;br&gt;500 — транзакция откатывается" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.7;fontColor=#475467;fontStyle=0;spacing=2;opacity=100;" vertex="1" parent="1">
