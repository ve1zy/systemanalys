        <mxCell id="sq-next-card-t0099" value="СПРАВКА ПО ОЧЕРЕДИ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.8;fontColor=#667085;fontStyle=1;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1476" y="162" width="268" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sq-next-card-t0103" value="ПРИОРИТЕТ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.6;fontColor=#16181D;fontStyle=1;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="208" width="244" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sq-next-card-t0104" value="1. in_rotation и next_review_at ≤ now.&lt;br&gt;2. ORDER BY next_review_at ASC.&lt;br&gt;3. Новые слова — только если due пуст.&lt;br&gt;4. Иначе empty state.&lt;br&gt;Пример: sick 13:40 → feel 14:50." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=9.0;fontColor=#475467;fontStyle=0;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="228" width="244" height="180" as="geometry" />
        </mxCell>
        <mxCell id="sq-next-card-t0107" value="ОРИЕНТАЦИЯ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.6;fontColor=#16181D;fontStyle=1;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="440" width="244" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sq-next-card-t0108" value="Новое слово — всегда EN → RU.&lt;br&gt;Ротация — случайно EN → RU / RU → EN.&lt;br&gt;Перевод передаётся, но скрыт до «Показать»." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=9.0;fontColor=#475467;fontStyle=0;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="460" width="244" height="142" as="geometry" />
        </mxCell>
        <mxCell id="sq-next-card-t0111" value="КОНТРАКТ 200" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.6;fontColor=#16181D;fontStyle=1;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="634" width="244" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sq-next-card-t0112" value="{ type: 'due' | 'new', card, stage, orientation, due_at }&lt;br&gt;204 — карточек больше нет&lt;br&gt;401 — истёк токен" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.8;fontColor=#475467;fontStyle=0;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="654" width="244" height="144" as="geometry" />
