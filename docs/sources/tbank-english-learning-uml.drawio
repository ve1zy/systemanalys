        <mxCell id="uc-learning-t0054" value="Post-MVP: drag’n’drop, примеры употребления, ручное повторение выученных, пуши." style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.2;fontColor=#667085;fontStyle=2;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="930" y="1028" width="430" height="32" as="geometry" />
        </mxCell>
        <mxCell id="uc-learning-t0056" value="ПРАВИЛА И ОГРАНИЧЕНИЯ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.8;fontColor=#667085;fontStyle=1;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1476" y="162" width="268" height="16" as="geometry" />
        </mxCell>
        <mxCell id="uc-learning-t0060" value="ОЧЕРЕДЬ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.6;fontColor=#16181D;fontStyle=1;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="208" width="244" height="16" as="geometry" />
        </mxCell>
        <mxCell id="uc-learning-t0061" value="1. in_rotation и next_review_at ≤ now.&lt;br&gt;2. ORDER BY next_review_at ASC.&lt;br&gt;3. Новые слова — только если due пуст.&lt;br&gt;4. Иначе empty state.&lt;br&gt;Пример (14.01): sick 13:40 → feel 14:50." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.8;fontColor=#475467;fontStyle=0;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="228" width="244" height="152" as="geometry" />
        </mxCell>
        <mxCell id="uc-learning-t0064" value="НОВОЕ СЛОВО" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.6;fontColor=#16181D;fontStyle=1;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="412" width="244" height="16" as="geometry" />
        </mxCell>
        <mxCell id="uc-learning-t0065" value="Тип: EN → RU, перевод скрыт; транскрипция видна.&lt;br&gt;«Уже знаю» — слово исключается навсегда.&lt;br&gt;«Не знал» — этап 1, первый повтор через 5 мин." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.8;fontColor=#475467;fontStyle=0;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="432" width="244" height="152" as="geometry" />
        </mxCell>
        <mxCell id="uc-learning-t0068" value="РОТАЦИЯ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.6;fontColor=#16181D;fontStyle=1;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="616" width="244" height="16" as="geometry" />
        </mxCell>
        <mxCell id="uc-learning-t0069" value="Ориентация случайна: EN → RU или RU → EN.&lt;br&gt;На карточке — этап N / 8.&lt;br&gt;«Запомнил» — следующий этап; после 8-го слово&lt;br&gt;memorized.&lt;br&gt;«Не запомнил» — +5 мин и +1 ч, затем следующий этап." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.8;fontColor=#475467;fontStyle=0;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="636" width="244" height="200" as="geometry" />
        </mxCell>
        <mxCell id="uc-learning-t0072" value="ДОПУЩЕНИЕ В ТЗ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.6;fontColor=#B54708;fontStyle=1;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="868" width="244" height="16" as="geometry" />
        </mxCell>
        <mxCell id="uc-learning-t0073" value="Указаны 8 подтверждений и 6 интервалов. Для этапов 7–8&lt;br&gt;приняты +6 и +12 мес. — требует согласования с&lt;br&gt;заказчиком." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.8;fontColor=#7A2E0E;fontStyle=0;spacing=2;opacity=100;" vertex="1" parent="1">
