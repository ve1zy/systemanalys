        <mxCell id="sq-admin-t0139" value="ИМПОРТ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.6;fontColor=#16181D;fontStyle=1;spacing=2;opacity=100;" vertex="1" parent="1">
