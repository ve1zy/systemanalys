        <mxCell id="sq-review-t0118" value="7" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.2;fontColor=#16181D;fontStyle=1;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1478" y="366" width="26" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sq-review-t0119" value="6 месяцев*" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.8;fontColor=#344054;fontStyle=0;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1512" y="366" width="228" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sq-review-t0121" value="8" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.2;fontColor=#16181D;fontStyle=1;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1478" y="390" width="26" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sq-review-t0122" value="12 месяцев*" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.8;fontColor=#344054;fontStyle=0;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1512" y="390" width="228" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sq-review-t0123" value="* этапы 7–8 — допущение; требуется согласование." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=7.8;fontColor=#B54708;fontStyle=2;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1478" y="414" width="264" height="14" as="geometry" />
        </mxCell>
        <mxCell id="sq-review-t0126" value="ЗАВЕРШЕНИЕ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.6;fontColor=#16181D;fontStyle=1;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="450" width="244" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sq-review-t0127" value="8-е успешное подтверждение → status=memorized,&lt;br&gt;next_review_at=NULL. Слово исчезает из очереди и&lt;br&gt;попадает в статистику." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.7;fontColor=#475467;fontStyle=0;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="470" width="244" height="94" as="geometry" />
        </mxCell>
        <mxCell id="sq-review-t0130" value="ВЕТКА «НЕ ЗАПОМНИЛ»" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.6;fontColor=#16181D;fontStyle=1;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="598" width="244" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sq-review-t0131" value="POST result='not_remembered': слово повторяется через 5&lt;br&gt;мин и 1 ч, затем возвращается к следующему этапу.&lt;br&gt;Отдельный сценарий, не в этой диаграмме." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.6;fontColor=#475467;fontStyle=0;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="618" width="244" height="122" as="geometry" />
        </mxCell>
        <mxCell id="sq-review-t0134" value="ГАРАНТИИ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.6;fontColor=#16181D;fontStyle=1;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="774" width="244" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sq-review-t0135" value="Idempotency-Key; SELECT … FOR UPDATE; 409 при&lt;br&gt;устаревшем stage; аудит и история повторений." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.7;fontColor=#475467;fontStyle=0;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="794" width="244" height="94" as="geometry" />
        </mxCell>
        <mxCell id="sq-review-t0138" value="НОТАЦИЯ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.6;fontColor=#16181D;fontStyle=1;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="922" width="244" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sq-review-t0139" value="Сплошная — вызов, пунктир — возврат.&lt;br&gt;alt / opt — ветвление; полоса — активация." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.2;fontColor=#475467;fontStyle=0;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1488" y="942" width="244" height="72" as="geometry" />
        </mxCell>
        <mxCell id="sq-review-t0142" value="Допущение: 8 успешных повторений. Интервалы: 5 мин → 1 ч → 1 день → 1 нед. → 1 мес. → 3 мес. → 6 мес.* → 12 мес.*  В ТЗ перечислены 6 интервалов при 8 подтверждениях — этапы 7–8 нужно согласовать." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=9.2;fontColor=#475467;fontStyle=0;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="48" y="1102" width="1696" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sq-review-t0144" value="T · English Learning Platform · UML-модель MVP" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.2;fontColor=#98A2B3;fontStyle=0;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="60" y="1229" width="1050" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sq-review-t0145" value="v1.0 · 25.10.2026" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.2;fontColor=#98A2B3;fontStyle=0;spacing=2;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="1270" y="1229" width="470" height="16" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
