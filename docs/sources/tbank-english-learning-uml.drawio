        </mxCell>
        <mxCell id="sq-admin-t0136" value="Предусловие: модератор/администратор уже&lt;br&gt;авторизован. Модератор: статистика и словари.&lt;br&gt;Администратор: + роли. RBAC — на каждом запросе." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.8;fontColor=#475467;fontStyle=0;spacing=2;opacity=100;" vertex="1" parent="1">
