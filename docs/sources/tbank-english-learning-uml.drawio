          <mxGeometry x="1488" y="650" width="244" height="16" as="geometry" />
        </mxCell>
        <mxCell id="sq-admin-t0144" value="Optimistic locking по version (If-Match). 409 → показать&lt;br&gt;конфликт и не перезаписывать. Audit log: кто/что/когда." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.7;fontColor=#475467;fontStyle=0;spacing=2;opacity=100;" vertex="1" parent="1">
