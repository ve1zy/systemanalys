        </mxCell>
        <mxCell id="sq-admin-t0148" value="XLSX с колонками word, translation, transcription, type. Имя:&lt;br&gt;vocabulary-{id}.xlsx. Файл собирает backend." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=8.7;fontColor=#475467;fontStyle=0;spacing=2;opacity=100;" vertex="1" parent="1">
